# Variáveis de ambiente — NUNCA comite o arquivo .env real!
# Copie este arquivo para .env e preencha com os valores reais.

# ID do projeto Supabase (visível na URL do dashboard)
SUPABASE_PROJECT_ID="seu-project-id-aqui"

# URL do projeto Supabase
SUPABASE_URL="https://seu-project-id.supabase.co"

# Chave pública (anon/publishable) — visível no Supabase > Settings > API
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Prefixo VITE_ necessário para acesso no frontend (Vite build)
VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Chave secreta de serviço — SOMENTE para servidor, NUNCA expor no frontend
# Encontre em: Supabase > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
